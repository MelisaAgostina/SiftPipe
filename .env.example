# Copy to .env (gitignored, never commit it) and fill in real values.
# This file also feeds the CI docker-smoke job (see .github/workflows/ci.yml),
# which copies it as-is - none of these placeholders are called for real there,
# they only need to be non-empty so Docker Compose variable interpolation and
# NaViQ's entrypoint.sh (which requires NAVIQ_PASSWORD to be set) don't fail.

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

SIFTPIPE_ADMIN_PASSWORD=change-me
SIFTPIPE_SESSION_SECRET=change-me-to-a-random-64-char-hex-string

MM_ADMIN_EMAIL=admin@example.com
MM_ADMIN_PASS=change-me

# used by dynamic_analysis.py (B4) and dynamic_injector.py (B7) for Playwright login
MM_URL=http://localhost:8065
MM_TEAM=equipo-tesina
MM_USERNAME=victima@example.com
MM_PASSWORD=change-me

# used by dynamic_analysis.py (B4) to build the routes it crawls - and by seed.py, which creates the
# user (MM_USERNAME as email, MM_SEED_USERNAME, MM_PASSWORD), team (MM_TEAM) and channel from these same values
MM_CHANNEL=canal-analisis
MM_SEED_USERNAME=usuario_test

# NaViQ target - local dev instance only, port 8001, started from naviq-src/naviq/
# (its own separate .env there controls the Django app itself; these are SiftPipe's
# login credentials for it)
NAVIQ_URL=http://127.0.0.1:8001
NAVIQ_USERNAME=siftpipe_test
NAVIQ_PASSWORD=change-me
